{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Placement: GUI (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/placement_gui",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "placement: build debug",
      "environment": [
        {
          "name": "QT_QPA_PLATFORMTHEME",
          "value": "generic"
        },
        {
          "name": "QT_STYLE_OVERRIDE",
          "value": "Fusion"
        }
      ]
    },
    {
      "name": "Placement: CLI (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/placement_cli",
      "args": [
        "--help"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "placement: build debug",
      "environment": []
    }
  ]
}
