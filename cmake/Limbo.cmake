# 只构建实际消费的 LEF/DEF 5.8 解析器和 GDS 流写出器，不引入整个上游工程。
set(LIMBO_SOURCE_DIR "${CMAKE_SOURCE_DIR}/build/deps/Limbo" CACHE PATH "Pinned Limbo source tree")
set(LIMBO_COMMIT "6c115bfb1d4dca3a92044d505ee00456aac2bd45")
if(NOT EXISTS "${LIMBO_SOURCE_DIR}/limbo/parsers/gdsii/stream/GdsWriter.cpp")
  message(FATAL_ERROR "Limbo missing. Clone https://github.com/limbo018/Limbo.git and checkout ${LIMBO_COMMIT}; set LIMBO_SOURCE_DIR.")
endif()
execute_process(COMMAND git -c "safe.directory=${LIMBO_SOURCE_DIR}" -C "${LIMBO_SOURCE_DIR}" rev-parse HEAD OUTPUT_VARIABLE limbo_actual OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT limbo_actual STREQUAL LIMBO_COMMIT)
  message(FATAL_ERROR "Limbo revision mismatch: expected ${LIMBO_COMMIT}, got ${limbo_actual}")
endif()
find_program(BISON_EXECUTABLE bison HINTS "${PLACEMENT_DEPS_PREFIX}/bin" REQUIRED)
foreach(format lef def)
  set(parser_root "${LIMBO_SOURCE_DIR}/limbo/thirdparty/lefdef/5.8/${format}/${format}")
  set(parser_generated "${CMAKE_BINARY_DIR}/limbo/${format}")
  file(MAKE_DIRECTORY "${parser_generated}")
  # 本地 Bison 包需要显式数据目录；系统包直接使用默认目录。
  if(EXISTS "${PLACEMENT_DEPS_PREFIX}/share/bison")
    set(bison_env "BISON_PKGDATADIR=${PLACEMENT_DEPS_PREFIX}/share/bison" "M4=${PLACEMENT_DEPS_PREFIX}/bin/m4" "PATH=${PLACEMENT_DEPS_PREFIX}/bin:$ENV{PATH}")
  else()
    set(bison_env)
  endif()
  add_custom_command(OUTPUT "${parser_generated}/${format}.tab.cpp" "${parser_generated}/${format}.tab.h"
    COMMAND "${CMAKE_COMMAND}" -E env ${bison_env} "${BISON_EXECUTABLE}" "--defines=${parser_generated}/${format}.tab.h" "-p${format}yy" -o "${parser_generated}/${format}.tab.cpp" "${parser_root}/${format}.y"
    DEPENDS "${parser_root}/${format}.y" VERBATIM)
  file(GLOB parser_sources "${parser_root}/*.cpp")
  add_library(limbo_${format} STATIC ${parser_sources} "${parser_generated}/${format}.tab.cpp")
  target_include_directories(limbo_${format} SYSTEM PUBLIC "${LIMBO_SOURCE_DIR}" "${parser_root}" PRIVATE "${parser_generated}")
  target_compile_options(limbo_${format} PRIVATE -w)
endforeach()
add_library(limbo_gds STATIC "${LIMBO_SOURCE_DIR}/limbo/parsers/gdsii/stream/GdsWriter.cpp")
target_include_directories(limbo_gds SYSTEM PUBLIC "${LIMBO_SOURCE_DIR}")
target_compile_options(limbo_gds PRIVATE -w)
