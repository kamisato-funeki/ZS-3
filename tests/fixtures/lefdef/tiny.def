VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN tiny ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 40000 24000 ) ;
ROW R0 CoreSite 0 4000 N DO 20 BY 1 STEP 2000 0 ;
ROW R1 CoreSite 0 12000 N DO 20 BY 1 STEP 2000 0 ;
COMPONENTS 2 ;
- A CELL + PLACED ( 2000 4000 ) N ;
- B CELL + PLACED ( 14000 12000 ) N ;
END COMPONENTS
PINS 1 ;
- PORT + NET AP + DIRECTION INPUT + LAYER M1 ( -100 -100 ) ( 100 100 ) + FIXED ( -2000 6000 ) N ;
END PINS
NETS 2 ;
- AB ( A P ) ( B P ) ;
- AP ( A P ) ( PIN PORT ) ;
END NETS
END DESIGN
