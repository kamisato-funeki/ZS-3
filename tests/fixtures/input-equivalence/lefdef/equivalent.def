VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN equivalent ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 20000 20000 ) ;
ROW R0 CoreSite 0 0 N DO 10 BY 1 STEP 2000 0 ;
ROW R1 CoreSite 0 4000 N DO 10 BY 1 STEP 2000 0 ;
ROW R2 CoreSite 0 8000 N DO 10 BY 1 STEP 2000 0 ;
ROW R3 CoreSite 0 12000 N DO 10 BY 1 STEP 2000 0 ;
ROW R4 CoreSite 0 16000 N DO 10 BY 1 STEP 2000 0 ;
COMPONENTS 2 ;
- A CELL_A + PLACED ( 2000 2000 ) N ;
- B CELL_B + FIXED ( 14000 10000 ) N ;
END COMPONENTS
PINS 1 ;
- PORT + NET AP + DIRECTION INPUT + LAYER M1 ( -100 -100 ) ( 100 100 ) + FIXED ( -2000 6000 ) N ;
END PINS
NETS 2 ;
- AB ( A P ) ( B P ) + WEIGHT 2 ;
- AP ( A P ) ( PIN PORT ) + WEIGHT 0 ;
END NETS
END DESIGN
